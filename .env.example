# Feishu self-built app credentials. Never expose these to the browser.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_BITABLE_APP_TOKEN=
FEISHU_BITABLE_TABLE_ID=

# This key is sent with browser tile requests. Restrict it to deployed domains
# and map-tile permissions in the Tianditu console.
NEXT_PUBLIC_TIANDITU_TILE_KEY=
